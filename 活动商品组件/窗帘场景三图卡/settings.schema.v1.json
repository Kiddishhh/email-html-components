{
  "schemaVersion": 1,
  "componentKey": "collection.curtainEditorialTriptych",
  "themeMode": "component-owned-styles",
  "snapshotPolicy": "full-settings-snapshot",
  "properties": {
    "color.surface": {
      "type": "string",
      "default": "#FBFAF8",
      "themeable": true,
      "skillPrompt": true,
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "color.text": {
      "type": "string",
      "default": "#1F1F1F",
      "themeable": false,
      "skillPrompt": false,
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "color.body": {
      "type": "string",
      "default": "#000000",
      "themeable": false,
      "skillPrompt": false,
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "font.heading": {
      "type": "string",
      "default": "Lora, Georgia, Times New Roman, serif",
      "themeable": false,
      "skillPrompt": false,
      "pattern": "^[A-Za-z, -]+$"
    },
    "font.body": {
      "type": "string",
      "default": "Montserrat, Arial, Helvetica, sans-serif",
      "themeable": false,
      "skillPrompt": false,
      "pattern": "^[A-Za-z, -]+$"
    }
  },
  "additionalProperties": false
}
